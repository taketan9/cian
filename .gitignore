/target
# Each spike is its own cargo workspace, so each grows a `target/` of its own —
# `/target` above does not reach them.
/spikes/*/target
# The bundled font is fetched at build time, not committed: twelve megabytes
# that would sit in every clone forever. See .github/workflows/release.yml.
# （2026-09-06 に `crates/cian-gui/fonts/` から移した。あのクレートが出たので）
/vendor-font/
**/*.rs.bk
.DS_Store

# Byte-cache for cian_ai.py, written whenever the helper is imported (running
# it, or a test that pokes at it). Only cian_ai.py itself is embedded, via
# include_str!, so this is pure local churn — and version-specific besides.
__pycache__/
*.py[cod]

# あふ本体（リファレンス資料）はリポジトリ管理対象外。手元のみで参照。
/あふ/

# Local handoff doc for cross-session continuity; not part of the project.
/HANDOFF.md
# What the release workflow stages before zipping, and what `bundle.sh` leaves
# if it is pointed here: a whole application bundle, binaries and all.
/cian-macos/
/cian-windows-x64/
/target/cian.app

# Local Claude Code settings. The skill link beside it is shared.
.claude/settings.local.json

# The Electron front end fetches its own dependencies; the packaging story for
# them is node_modules.zip, the same as crmaine. See gui/package.json.
/gui/node_modules/
gui/vendor/

# Where a particular machine keeps Electron. run.bat reads it; it is one line
# and it is nobody else's business. Deliberately not shipped in the zip either
# — a file that ships is a file the next version overwrites, which is the whole
# reason this exists instead of editing run.bat.
gui/electron.txt

# Xcode がここに建てる（資材は scripts/ios-build.sh が作り直す）
ios/build/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/
